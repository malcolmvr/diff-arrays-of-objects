{
  "compilerOptions": {
    "target": "ES2019",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "allowJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "lib",
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"]
  },
  "include": ["lib/**/*.ts", "lib/**/*.mts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
