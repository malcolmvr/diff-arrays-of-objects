{
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "rootDir": "."
  },
  "include": [
    "lib/**/*.ts",
    "lib/**/*.mts",
    "test/**/*.ts",
    "test/**/*.mts",
