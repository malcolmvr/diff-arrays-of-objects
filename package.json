{
  "name": "@wvanderp/diff-arrays-of-objects",
  "description": "Compare two arrays of objects, finding added, removed, updated and identical objects. Details the differences between updated objects.",
  "homepage": "https://github.com/wvanderp/diff-arrays-of-objects",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/deep-diff": "./dist/deep-diff/index.js",
    "./dist/*.js": "./dist/*.js",
    "./dist/*": "./dist/*.js"
  },
  "author": {
    "email": "malcolm@van.raalte.ca",
    "name": "Malcolm van Raalte",
    "url": "https://github.com/malcolmvr"
  },
  "contributors": [
    {
      "email": "victorfern91@gmail.com",
      "name": "Victor Fernandes",
      "url": "https://victorfern91.github.io"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wvanderp/diff-arrays-of-objects.git"
  },
  "bugs": {
    "url": "https://github.com/wvanderp/diff-arrays-of-objects/issues"
  },
  "keywords": [
    "added",
    "array",
    "compare",
    "deep",
    "delta",
    "diff",
    "difference",
    "object",
    "removed",
    "updated",
    "objects"
  ],
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^10.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run build && npm run lint && npm run typecheck",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test": "vitest run --coverage && npm run test:package",
    "test:package": "node test/package-smoke.mjs",
    "prebench": "npm run build",
    "bench": "vitest bench --run"
  },
  "type": "module"
}
